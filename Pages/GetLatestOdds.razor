@page "/get_latest_odds"
@using Football_Two.Services
@using Football_Two.Models

@inject GetOdds oddsService

<h5>GetLatestOdds</h5>

<div>
    <button class="btn btn-primary" @onclick="GetOdds">Get Latest Odds</button>
    <button class="btn btn-primary" @onclick="GetTestOdds" style="margin-left:24px;">Load Test Odds</button>
</div>

<div style="margin-top:16px;">
    <label>@retrieveOddsStatus</label>
</div>

@code {

    private string retrieveOddsStatus;

    private async void GetOdds()
    {
        retrieveOddsStatus = "Working on it....";
        await oddsService.GetLatestOdds(true);
        retrieveOddsStatus = "Complete";
    }

    private async void GetTestOdds()
    {
        retrieveOddsStatus = "Working on it....";
        await oddsService.GetLatestOdds(false);
        retrieveOddsStatus = "Complete";
    }
}
