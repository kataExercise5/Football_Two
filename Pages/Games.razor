@page "/games"

@using Football_Two.Services
@using Football_Two.Models

@inject DataAccess dataAccess
@inject NavigationManager navMgr

<h5>Games</h5>
 
<div>
    <div class="two-grid">
        <div>
            <ScheduleSelect parmScheduleYearWeek="@scheduleYearWeek"></ScheduleSelect>
        </div>
        <div style="text-align:middle;">
            <button class="btn btn-primary" style="margin-left:10px;" @onclick="GetGames">Select Games</button>
        </div>
    </div>


    @if (games != null && games.Length > 0)
    {
        @if (updateMode)
        {
            <button class="btn btn-primary" style="margin-left:20px;" @onclick="SaveScores">Save</button>
            <button class="btn btn-primary" style="margin-left:20px;" @onclick="CancelScores">Cancel</button>
        }
        else
        {
            <button class="btn btn-primary" style="margin-left:20px;" @onclick="EditScores">Update Scores</button>
        }
    }

    
</div>

<div style="margin-top:20px;">
    @if (games is not null && games.Length > 0)
    {
        <div class="tableFixHead">
            <table>
                <thead>
                    <tr>
                        <th>Odds</th>
                        <th>Game Id</th>
                        <th>Vid</th>
                        <th>Visiting Team</th>
                        <th>Hid</th>
                        <th>Home Team</th>
                        <th>Date</th>
                        <th>Visitor Score</th>
                        <th>Home Score</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var game in games)
                    {
                        <tr>
                            <td>
                                <button class="btn btn-primary" style="margin-left:20px;" @onclick="(() => ShowOdds(game.gameId))">Show Odds</button>
                            </td>
                            <td>@game.gameId</td>
                            <td>@game.visitingTeamId</td>
                            <td>@game.visitingTeamName</td>
                            <td>@game.homeTeamId</td>
                            <td>@game.homeTeamName</td>
                            <td>@game.datePlayed</td>
                            <td>
                                @if (updateMode)
                                {
                                    <input type="number" class="ScoreUpdate" @bind="@game.visitingTeamScore" />
                                }
                                else
                                {
                                    @game.visitingTeamScore
                                }
                            </td>
                            <td>
                                @if (updateMode)
                                {
                                 <input type="number" class="ScoreUpdate" @bind="@game.homeTeamScore" />
                                }
                                else
                                {
                                    @game.homeTeamScore
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@code {

    private Game[]? games;
    private ScheduleYearWeek[]? scheduleYearWeekList = null;
    private Dictionary<int, string>? formatedScheduleWeeks;

    public ScheduleYearWeek scheduleYearWeek = new ScheduleYearWeek();
    private bool updateMode = false;

    protected override async Task OnInitializedAsync()
    {
    }

    private async void GetGames()
    {
        games = await dataAccess.GameQuery(scheduleYearWeek.year, scheduleYearWeek.week);
    }

    private async void EditScores()
    {
        updateMode = true;
    }

    private async void SaveScores()
    {
        foreach (var game in games)
        {
            int rc = dataAccess.ScoreUpdate(game.gameId, game.visitingTeamScore.Value, game.homeTeamScore.Value);
        }

        updateMode = false;
    }

    private async void CancelScores()
    {
        updateMode = false;
    }

    private async void ShowOdds(int selectedGameId)
    {
        string url = "/odds/" + selectedGameId.ToString();
        navMgr.NavigateTo(url);
    }
}
