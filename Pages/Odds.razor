@page "/odds/{gameIdStr}"

@using Football_Two.Models
@using Football_Two.Services

@inject DataAccess dataAccess

<style>
    td, th {
        margin-top: 7px;
        margin-bottom: 7px;
        margin-left: 7px;
        margin-right: 7px;
    }
</style>

<h5>Odds</h5>

<div style="border:solid">
    <label style="font-weight:bold">Schedule Year:</label> <label>@game.scheduleYear</label>
    <label style="font-weight:bold; margin-left:15px;">Schedule Week:</label> <label>@game.scheduleWeek</label>
    <label style="font-weight:bold; margin-left:15px;">Date:</label> <label>@game.datePlayed</label>
    <label style="font-weight:bold; margin-left:15px;">Visitor:</label> <label>@game.visitingTeamName</label>
    @if (game.visitingTeamScore != null)
    {
        <label style="margin-left:5px;">@game.visitingTeamScore</label>
    }
    <label style="font-weight:bold; margin-left:15px;">Home:</label> <label>@game.homeTeamName</label>
    @if (game.homeTeamScore != null)
    {
        <label style="margin-left:5px;">@game.homeTeamScore</label>
    }
</div>

<div>
    <div class="odds-grid">

        <div>
            <div class="tableFixHead">
                <table>
                    <tbody>
                        <tr>
                            <td style="width:20%">Team</td>
                            <td style="width:20%">BookMaker</td>
                            <td style="width:20%">Date Published</td>
                            <td style="width:10%">Price</td>
                            <td style="width:10%">Spread</td>
                            <td style="width:12%">Bet Type</td>
                            <td style="width:8%">Result</td>
                        </tr>
                    </tbody>
                </table>
            </div>

            <div class="table-container">
                <table>
                    <tbody>
                        @foreach (var line in oddsLines)
                        {
                            <tr>
                                <td style="width:20%">@line.teamName</td>
                                <td style="width:20%">@line.bookMakerTitle</td>
                                <td style="width:20%">@line.datePublished.ToShortDateString()</td>
                                <td style="width:10%">@line.price</td>
                                <td style="width:10%">@line.spread</td>
                                <td style="width:12%">@line.betType</td>
                                <td style="width:8%">Result</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>


        <div class="options-grid">
            @* column 1 of filter and sort select area *@
            <div>
                <div style="text-align:center; margin-top:15px;" >
                    <select name="filter_available" size="7" value="@filterAvailableSelected"
                            @onchange="@((ChangeEventArgs e) => filterAvailableSelected = e.Value.ToString())">
                        >
                        <option value=""></option>
                        @foreach (var item in filterAvailableList)
                        {
                            <option value="@item">@item</option>
                        }
                    </select>
                </div>

                <div style="text-align:center; margin-top:15px;">
                    <select value="sortAvailableSelected" size="7"
                            @onchange="@((ChangeEventArgs e) => sortAvailableSelected = e.Value.ToString())">
                        >
                        <option value=""></option>
                        @foreach (var item in sortAvailableList)
                        {
                            <option value="@item">@item</option>
                        }
                    </select>
                </div>
            </div>

            @* column 2 of filter and sort select area *@
            <div>
                <div>
                    <div style="text-align:center; margin-top:15px;">
                        <img src="icons/right-arrow.png" @onclick="AddFilter" />
                    </div>
                    <div class="container" style="text-align:center; margin-top:10px;">
                        <img src="icons/left-arrow.png" @onclick="RemoveFilter" />
                        <button class="btn"></button>
                    </div>
                </div>

                <div style="margin-top:30px;">
                    <div style="text-align:center; margin-top:15px;">
                        <img src="icons/right-arrow.png" @onclick="AddSort" />
                    </div>
                    <div class="container" style="text-align:center; margin-top:10px;">
                        <img src="icons/left-arrow.png" @onclick="RemoveSort" />
                        <button class="btn"></button>
                    </div>
                </div>
            </div>

            @* column 3 of filter and sort select area *@
            <div>
                <div style="text-align:center; margin-top:15px;">
                    <select name="filter_using" size="7" value="@filterUsingSelected"
                            @onchange="@((ChangeEventArgs e) => filterUsingSelected = e.Value.ToString())">
                        <option value=""></option>
                        @foreach (var item in filterUsingList)
                        {
                            <option value="@item">@item</option>
                        }
                    </select>
                </div>

                <div style="text-align:center; margin-top:15px;">
                    <select name="sort_using" size="7" value="@sortUsingSelected"
                            @onchange="@((ChangeEventArgs e) => sortUsingSelected = e.Value.ToString())">
                        <option value=""></option>
                        @foreach (var item in sortUsingList)
                        {
                            <option value="@item">@item</option>
                        }
                    </select>
                </div>
            </div>

        </div>
    </div>

</div>



@code {
    [Parameter]
    public string? gameIdStr { get; set; }

    private Game game;
    private int gameId;

    private OddsLine[] oddsLines;

    private string filterAvailableSelected = string.Empty;
    private string filterUsingSelected = string.Empty;
    private string sortAvailableSelected = string.Empty;
    private string sortUsingSelected = string.Empty;

    private List<string> initialList = new List<string>
    {
        "Team", "BookMaker", "Published", "Bet Type", "Spread", "Price", "Result"
    };
    private List<string> filterAvailableList = new List<string>();
    private List<string> filterUsingList = new List<string>();
    private List<string> sortAvailableList = new List<string>();
    private List<string> sortUsingList = new List<string>();


    protected override async Task OnInitializedAsync()
    {
        if (int.TryParse(gameIdStr, out gameId))
        {
            PopulateGameAndOdds();
            PopulateSortAndFilters();
        }
        else
        {
            gameId = -9;
        }
    }

    private async void PopulateGameAndOdds()
    {
        game = await dataAccess.GameQueryById(gameId);
        game.visitingTeamScore = 32;
        game.homeTeamScore = 13;

        oddsLines = await dataAccess.OddsQueryByGame(gameId);
    }

    private void PopulateSortAndFilters()
    {
        filterAvailableList = new List<string>(initialList);
        sortAvailableList = new List<string>(initialList);
        StateHasChanged();
    }

    private void FilterAvailableUpdate(string filterAvail)
    {
        filterAvailableSelected = filterAvail;
    }

    private void RemoveFilter()
    {
        filterAvailableList.Add(filterUsingSelected);
        filterUsingList.Remove(filterUsingSelected);
        StateHasChanged();
    }

    private void AddFilter()
    {
        filterUsingList.Add(filterAvailableSelected);
        filterAvailableList.Remove(filterAvailableSelected);
        StateHasChanged();
    }

    private void RemoveSort()
    {
        sortAvailableList.Add(sortUsingSelected);
        sortUsingList.Remove(sortUsingSelected);
        StateHasChanged();
    }

    private void AddSort()
    {
        sortUsingList.Add(sortAvailableSelected);
        sortAvailableList.Remove(sortAvailableSelected);
        StateHasChanged();
    }
}
