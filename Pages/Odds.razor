@page "/odds/{gameIdStr}"

@using Football_Two.Models
@using Football_Two.Services

@inject DataAccess dataAccess

<style>
    td, th {
        margin-top: 7px;
        margin-bottom: 7px;
        margin-left: 7px;
        margin-right: 7px;
    }
</style>

<h5>Odds</h5>

<div style="border:solid">
    <label style="font-weight:bold">Schedule Year:</label> <label>@game.scheduleYear</label>
    <label style="font-weight:bold; margin-left:15px;">Schedule Week:</label> <label>@game.scheduleWeek</label>
    <label style="font-weight:bold; margin-left:15px;">Date:</label> <label>@game.datePlayed</label>
    <label style="font-weight:bold; margin-left:15px;">Visitor:</label> <label>@game.visitingTeamName</label>
    @if (game.visitingTeamScore != null)
    {
        <label style="margin-left:5px;">@game.visitingTeamScore</label>
    }
    <label style="font-weight:bold; margin-left:15px;">Home:</label> <label>@game.homeTeamName</label>
    @if (game.homeTeamScore != null)
    {
        <label style="margin-left:5px;">@game.homeTeamScore</label>
    }
</div>

<div>
    <div class="odds-grid">

        <div>
            <div class="tableFixHead">
                <table>
                    <tbody>
                        <tr>
                            <td style="width:20%">Team</td>
                            <td style="width:20%">BookMaker</td>
                            <td style="width:20%">Date Published</td>
                            <td style="width:12%">Bet Type</td>
                            <td style="width:10%">Price</td>
                            <td style="width:10%">Spread</td>
                            <td style="width:8%">Result</td>
                        </tr>
                    </tbody>
                </table>
            </div>

            <div class="table-container">
                <table>
                    <tbody>
                        @foreach (var line in oddsLines)
                        {
                            <tr>
                                <td style="width:20%">
                                    <button @onclick="@(() => teamIdFilter = line.teamId)"> @line.teamName</button>
                                </td>
                                <td style="width:20%">
                                    <button @onclick="@(() => bookMakerIdFilter = line.bookMakerId)"> @line.bookMakerTitle</button>
                                </td>
                                <td style="width:20%">
                                    <button @onclick="@(() => datePublishedFilter = line.datePublished)"> @line.datePublished.ToShortDateString()</button>
                                </td>
                                <td style="width:12%">
                                    <button @onclick="@(() => betTypeFilter = line.betType)"> @line.betType</button>
                                </td>
                                <td style="width:10%">@line.price</td>
                                <td style="width:10%">@line.spread</td>
                                <td style="width:8%">@line.result</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <div>
        
            <div style="margin-top:15px; text-align:center;">
                <button class="btn btn-primary" @onclick="ApplyFilters">Apply Filters</button>
                <button class="btn btn-primary" @onclick="RemoveFilters">Remove Filters</button>
            </div>
        </div>

    </div>

</div>



@code {
    [Parameter]
    public string? gameIdStr { get; set; }

    private Game game;
    private int gameId;
    private DateTime doNotUsePublishedDate;

    private OddLine[] oddsLines;

    private int teamIdFilter;
    private int bookMakerIdFilter;
    private DateTime datePublishedFilter;
    private string betTypeFilter;


    protected override async Task OnInitializedAsync()
    {
        doNotUsePublishedDate = DateTime.Parse("1900-01-01");
        if (int.TryParse(gameIdStr, out gameId))
        {
            PopulateGameAndOdds();
            InitFilterValues();
        }
        else
        {
            gameId = -9;
        }
    }

    private void InitFilterValues()
    {
        teamIdFilter = 0;
        bookMakerIdFilter = 0;
        datePublishedFilter = doNotUsePublishedDate;
        betTypeFilter = string.Empty;
    }

    private async void PopulateGameAndOdds()
    {
        game = await dataAccess.GameQueryById(gameId);

        oddsLines = await dataAccess.OddsQueryByGame(gameId, doNotUsePublishedDate);
    }

    private async void ApplyFilters()
    {
        oddsLines = await dataAccess.OddsQueryByGame(gameId, datePublishedFilter, teamIdFilter, bookMakerIdFilter, betTypeFilter);
    }

    private async void RemoveFilters()
    {
        InitFilterValues();
        oddsLines = await dataAccess.OddsQueryByGame(gameId, datePublishedFilter, teamIdFilter, bookMakerIdFilter, betTypeFilter);
    }
}
