@page "/spread_results_by_week/"

@using Football_Two.Components
@using Football_Two.Services
@using Football_Two.Models

@inject AnalyzeDataService dataAccess

<h3>Spread Results By Week</h3>

<div class="four-grid">
    <div>
        <label>Year Start Week</label>
        <ScheduleSelect parmScheduleYearWeek="@scheduleYearWeekStart"></ScheduleSelect>
    </div>
    <div>
        <label>Year End Week</label>
        <ScheduleSelect parmScheduleYearWeek="@scheduleYearWeekEnd"></ScheduleSelect>
    </div>
    <div class="select-unit">
        <label style="margin-left:10px;">Spread:</label>
        <input type="text" class="ScoreUpdate" style="width:80px;" @bind="@spreadStr" />
    </div>
    <div>
        <button style="margin-left:24px;margin-top:24px;" class="btn btn-primary" @onclick="GetResults">Get Results</button>
    </div>
</div>

<div style="margin-top:20px;">
    @if (results != null)
    {
        titleIdx = 0;

    }
</div>

<div style="margin-top:20px;">
    @if (results != null)
    {
        resultsIdx = 0;
        @for (titleIdx = 1; titleIdx < 5; titleIdx++)
        {
            <div class="tableFixHead" style="margin-top:20px;">
                <h5 style="margin-bottom:5px;">@titles[titleIdx-1]</h5>
                <table>
                    <thead>
                        <tr>
                            <th>Book Maker</th>
                            @for (int weekIdx = scheduleYearWeekStart.week; weekIdx <= scheduleYearWeekEnd.week; weekIdx++)
                            {
                                <th>Week @weekIdx.ToString()</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @while (resultsIdx < results.Length && results[resultsIdx].titleIdx == titleIdx)
                        {
                            <tr>
                                <td>@results[resultsIdx].bookieName</td>
                                @for (int weekIdx = scheduleYearWeekStart.week; weekIdx <= scheduleYearWeekEnd.week; weekIdx++)
                                {
                                    <td>@results[resultsIdx].winnings</td>
                                    resultsIdx++;
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }

    }
</div>


@code {
    public ScheduleYearWeek scheduleYearWeekStart = new ScheduleYearWeek();
    public ScheduleYearWeek scheduleYearWeekEnd = new ScheduleYearWeek();
    private Result[] results;
    Dictionary<string, List<decimal>> spreadResults;
    private string spreadStr;
    private decimal spread;
    private int titleIdx;
    private int resultsIdx;

    private string[] titles = new string[4] { "Home Team Favored", "Visiting Team Favored", "Home Team Underdog", "Visiting Team Underdog" };

    protected override async Task OnInitializedAsync()
    {
    }


    private async void GetResults()
    {
        if (!(decimal.TryParse(spreadStr, out spread)))
        {
            spread = 0;
        }
        results = await dataAccess.SpreadResultsByWeek(scheduleYearWeekStart, scheduleYearWeekEnd.week, spread);

        // spreadResults = new Dictionary<string, List<decimal>>();
        // int idx = 0;
        // while (idx < results.Length)
        // {
        //     List<decimal> winnings = new List<decimal>();
        //     spreadResults.Add(results[idx].bookieName, winnings);
        //     for (int k = 0; k < 4; k++)
        //     {
        //         winnings.Add(results[idx].winnings);
        //         idx++;
        //     }
        // }
    }

}
